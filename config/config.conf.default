# /etc/cec-hdmi/config.conf
#
# Plain KEY=VALUE. Sourced by cec-hook.sh (bash) and parsed by
# cec-controller-watch.py (no shell expansion there - keep values literal).
# Re-running install.sh never overwrites this file; the shipped defaults are
# always mirrored to config.conf.default so you can diff after an upgrade.
#
# After editing:  sudo systemctl restart cec-hdmi-controller.service
# (only the CONTROLLER keys need that restart - cec-hook.sh re-reads this file
# on every wake/standby, so the CEC command keys below take effect immediately.)


# --- what gets sent over CEC -------------------------------------------------
#
# Both lists are semicolon-separated sets of cec-ctl arguments: each entry is
# one cec-ctl invocation, run in order, CEC_COMMAND_DELAY seconds apart, and the
# sequence stops at the first command that fails.
#
#   {phys_addr}   replaced with this PC's HDMI physical address (e.g. 3.0.0.0),
#                 re-detected on every run so it survives a port/cable change
#   -t0 / --to 0  address the message to logical device 0, which is the TV
#   -s            skip cec-ctl's adapter info dump
#   -v            verbose. KEEP IT: the retry logic decides whether the TV
#                 acknowledged by looking for "Not Acknowledged" in this output
#
# The default wake sequence: a remote-control "power on" keypress, the standard
# CEC wake, "switch to my HDMI port", then "I am the active source". TVs vary in
# which of these they honour - some need only --image-view-on, some ignore
# --user-control-pressed, some want --active-source repeated. Trying a different
# sequence is what this key is for; run "sudo bash /etc/cec-hdmi/cec-hook.sh on"
# after each edit and watch /etc/cec-hdmi/cec-hook.log.
CEC_WAKE_COMMANDS="-v -s -t0 --cec-version-1.4 --user-control-pressed=ui-cmd=power-on-function; -v -s -t0 --cec-version-1.4 --image-view-on; -v -s -t0 --cec-version-1.4 --set-stream-path=phys-addr={phys_addr}; -v -s --cec-version-1.4 --active-source=phys-addr={phys_addr}"

# Sent on suspend, shutdown and reboot. Some setups prefer broadcasting standby
# to everything on the bus: CEC_STANDBY_COMMANDS="--to 15 --standby"
# To send the AVR to standby along with the TV, add it as a second command:
#   CEC_STANDBY_COMMANDS="--to 0 --standby; --to 5 --standby"
CEC_STANDBY_COMMANDS="--to 0 --standby"

# Audio system / AVR, sent once the TV has acknowledged the wake. "--to 5" is
# the audio system's logical address, and a System Audio Mode Request carrying
# our physical address is what makes an AVR power on and switch to this input.
#
# This list is best effort: unlike the wake commands, nothing here can fail a
# wake. With no AVR on the bus, logical address 5 simply does not answer and the
# log gets one "no audio system answered" line per wake - set the key to ""
# to stop sending it at all.
#
# If your AVR ignores this, run "cec-ctl -s -M" while pressing its power button
# to see what address it actually uses and which messages it accepts; some want
# a plain "--to 5 --user-control-pressed=ui-cmd=power-on-function" instead.
CEC_AUDIO_COMMANDS="-v -s --to 5 --system-audio-mode-request=phys-addr={phys_addr}"

# Seconds to wait between the commands of a list. A TV that has just powered on
# can drop messages that arrive back to back; 0 sends them without a pause.
CEC_COMMAND_DELAY=1


# --- controller watcher ------------------------------------------------------

# Ignore further Home-button presses for this many seconds after one fires.
# Also covers the duplicate events you get when Steam mirrors a physical pad
# onto a virtual uinput device. Fractional values are fine.
COOLDOWN_SECONDS=2.5

# Which button counts as "Home". Space- or comma-separated evdev key names, or
# raw numeric codes. A device is watched if it advertises at least one of these.
#   BTN_MODE      (316) Guide/Home/PS/Xbox button on almost every gamepad
#   BTN_HOME            not defined by mainline Linux input-event-codes.h; kept
#                       here for kernels/controllers that do define it, and
#                       harmlessly ignored (with a one-line note) when they do not
#   KEY_HOMEPAGE  (172) used by some Bluetooth pads that expose Home on a
#                       separate keyboard-ish input node
# Run "sudo /etc/cec-hdmi/cec-controller-watch.py --monitor" and press your
# button to find out what your controller actually sends.
BUTTON_CODES="BTN_MODE BTN_HOME KEY_HOMEPAGE"

# 1 = only watch devices that look like gamepads (advertise BTN_GAMEPAD/0x130).
# Default 0, because some controllers report Home on a separate non-gamepad node
# that would otherwise be skipped.
GAMEPAD_ONLY=0

# 1 = log "would trigger" instead of actually running cec-hook.sh. Lets you test
# button detection with no TV/CEC hardware involved.
DRY_RUN=0

# Safety-net rescan interval (seconds) for hotplugged controllers. Hotplug is
# normally instant via the kernel netlink uevent socket; this only backstops it.
RESCAN_SECONDS=5

# Desktop notifications (best effort; they generally show in Desktop Mode and
# not inside gamescope). 1 = on, 0 = off.
NOTIFY_ON_TRIGGER=0
NOTIFY_ON_FAILURE=1

# Log size cap. Each log is rotated to .1 .. .N once it reaches LOG_MAX_BYTES.
# Set LOG_MAX_BYTES=0 to disable rotation entirely.
LOG_MAX_BYTES=1048576
LOG_KEEP=2
