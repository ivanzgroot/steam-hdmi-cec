[Unit]
Description=HDMI-CEC: wake TV after resuming from suspend/hibernate
After=systemd-suspend.service
After=systemd-hibernate.service
After=systemd-hybrid-sleep.service
After=systemd-suspend-then-hibernate.service

[Service]
Type=oneshot
ExecStart=/etc/cec-hdmi/cec-hook.py on
# The DisplayPort tunneling bit is always clear at this point, so this is the
# path the whole project exists for. Generous timeout: re-enabling tunneling and
# escalating through a connector re-probe can take a while.
TimeoutStartSec=150

[Install]
WantedBy=systemd-suspend.service
WantedBy=systemd-hibernate.service
WantedBy=systemd-hybrid-sleep.service
WantedBy=systemd-suspend-then-hibernate.service
