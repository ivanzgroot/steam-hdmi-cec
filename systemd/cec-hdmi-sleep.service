[Unit]
Description=HDMI-CEC: standby TV before system sleep/suspend
Before=sleep.target

[Service]
Type=oneshot
ExecStart=/etc/cec-hdmi/cec-hook.py off
# This unit is holding up the suspend, so the standby path deliberately asks the
# bus nothing it does not have to. See Controller.plan_standby.
TimeoutStartSec=15

[Install]
WantedBy=sleep.target
